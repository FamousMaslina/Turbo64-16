+void common_log_set_metadata_only(common_log_metadata_filter filter) {
+    GGML_ASSERT(filter != nullptr);
+    common_log_metadata_filter expected = nullptr;
+    metadata_filter.compare_exchange_strong(expected, filter);
+}
+
+bool common_log_is_metadata_only() {
+    return metadata_filter.load() != nullptr;
+}
